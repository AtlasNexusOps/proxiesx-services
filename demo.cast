[15.089106, "o", "\r\n🍔 3. Food Delivery Price Intelligence (#76 — $50)\r\n─────────────────────────────────────────────────────\r\n\r\nPlatforms: Uber Eats, Deliveroo, DoorDash\r\nSchema: platform, restaurant_name, price, delivery_fee, rating...\r\n\r\n"]
