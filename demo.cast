[20.127437, "o", "\r\n🔐 4. x402 Payment Gateway (gateway/index.mjs)\r\n────────────────────────────────────────────────\r\n\r\nTech: Node.js + Hono + @proxies-sx/x402-hono\r\nFlow:  Request → x402 middleware → 402 Payment Required\r\n       User pays USDC → Gateway retries → Python scraper\r\n       Response ← Data Toolkit ← Scraper\r\n\r\nPricing:\r\n   /api/v1/track/{ASIN}         0.003 USDC\r\n   /api/v1/compare?restaurant=X 0.002 USDC\r\n"]
[25.129637, "o", "\r\n🐳 5. Deployment (Docker Compose)\r\n───────────────────────────────────\r\n\r\n"]
[25.139296, "o", "    container_name: proxiesx-scraper\r\n    restart: unless-stopped\r\n    environment:\r\n    # No ports exposed — only accessible via gateway\r\n\r\n  # Node.js x402 payment gateway (public-facing)\r\n    container_name: proxiesx-gateway\r\n    restart: unless-stopped\r\n    ports:\r\n      - \"${GATEWAY_PORT:-3000}:3000\"\r\n    environment:\r\n"]
[25.139607, "o", "\r\nDeploy:  docker compose up -d\r\n"]
[25.140395, "o", "Verify:  curl http://localhost:3000/health\r\n"]
